{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowJs": true,
    "checkJs": false,
    "lib": ["ES2022", "DOM", "WebWorker"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["vite/client", "vite-plugin-pwa/client", "vitest/globals", "node"]
  },
  "include": ["src/**/*.ts", "tests/**/*.ts", "vite.config.ts", "script.js"]
}
